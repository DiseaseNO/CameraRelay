# Bygger og laster opp til TestFlight.
#
# Signering går via `match`: sertifikat og provisioning-profil lagres KRYPTERT i et privat
# repo og gjenbrukes ved hver kjøring. Alternativet — å la fastlane lage dem på sparket —
# virker, men bruker opp et nytt distribusjonssertifikat per bygg, og Apple gir deg bare
# 2-3 av dem. Da står man fast etter noen runder.
#
# Ingen hemmeligheter i denne fila: alt kommer fra GitHub-secrets via miljøet.
default_platform(:ios)

APP_ID = "no.gustavs1.camerarelay"

platform :ios do
  desc "Bygg og last opp til TestFlight"
  lane :beta do
    # Midlertidig keychain på CI. Uten denne har ikke runneren noe sted å legge
    # sertifikatet, og signeringen feiler på et lite opplysende vis.
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )

    # Henter (eller oppretter første gang) sertifikat + profil fra match-repoet.
    match(
      type: "appstore",
      app_identifier: APP_ID,
      api_key: api_key,
      readonly: false,          # første kjøring MÅ få lov til å opprette
      git_url: ENV.fetch("MATCH_GIT_URL"),
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"]
    )

    # Byggnummer = løpenummeret til CI-kjøringen, så hver opplasting er unik.
    increment_build_number(
      xcodeproj: "CameraRelay.xcodeproj",
      build_number: ENV.fetch("GITHUB_RUN_NUMBER", Time.now.to_i.to_s)
    )

    profil = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][APP_ID]

    build_app(
      scheme: "CameraRelay",
      export_method: "app-store",
      project: "CameraRelay.xcodeproj",
      # Manuell signering: match har allerede lagt riktig sertifikat og profil på plass,
      # og automatisk signering ville prøvd å finne på noe eget.
      xcargs: "CODE_SIGN_STYLE=Manual PROVISIONING_PROFILE_SPECIFIER='#{profil}'",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { APP_ID => profil }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false   # interne testere trenger ingen Beta App Review
    )
  end
end
