# Bygger og laster opp til TestFlight. Ingen hemmeligheter her — App Store Connect
# API-nøkkelen kommer fra GitHub-secrets (base64-kodet .p8), signering er automatisk.
default_platform(:ios)

platform :ios do
  desc "Bygg og last opp til TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )

    # Byggnummer = løpenummeret til CI-kjøringen, så hver opplasting er unik.
    increment_build_number(
      xcodeproj: "CameraRelay.xcodeproj",
      build_number: ENV.fetch("GITHUB_RUN_NUMBER", Time.now.to_i.to_s)
    )

    build_app(
      scheme: "CameraRelay",
      export_method: "app-store",
      xcodeproj: "CameraRelay.xcodeproj",
      export_options: { signingStyle: "automatic" }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false   # interne testere trenger ingen Beta App Review
    )
  end
end
